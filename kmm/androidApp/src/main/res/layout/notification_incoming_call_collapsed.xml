<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
            android:id="@+id/iv_avatar_halo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bg_call_avatar_halo_voice" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/tv_avatar_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_call_avatar_fallback"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="LC"
                android:textColor="#FFE64A19"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_call_avatar_ring" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/badge_container"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_call_badge_voice">

            <ImageView
                android:id="@+id/iv_badge_icon"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_call_phone" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Caller"
            android:textColor="@color/call_notif_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_call_wave"
                android:layout_width="12dp"
                android:layout_height="9dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_call_wave_voice" />

            <TextView
                android:id="@+id/tv_call_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Incoming Voice Call"
                android:textColor="@color/call_notif_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btn_decline"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_call_btn_decline"
        android:clickable="true"
        android:contentDescription="Decline"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_call_end" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_accept"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_call_btn_accept_voice"
        android:clickable="true"
        android:contentDescription="Accept"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_accept_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_call_phone" />
    </FrameLayout>
</LinearLayout>
